MAILRELAY_VERSION=latest

# Server hostname — must match the PTR (reverse DNS) record of the server's IP
MAILRELAY_HOSTNAME=mail.example.com

# DMARC aggregate report recipient — leave empty to omit rua from DMARC records
DMARC_RUA=

# Space-separated list of domains allowed to send mail
# Managed by add-domain.sh — do not edit manually
ALLOWED_SENDER_DOMAINS=
